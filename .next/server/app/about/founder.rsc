11:["$","div",null,{"className":"bg-neutral-900/30 border border-neutral-800 rounded-lg p-8","children":["$","div",null,{"className":"space-y-4 text-neutral-300 text-sm leading-relaxed","children":[["$","p",null,{"children":"His path reflects the classical Sufi journey of detachment and inner realization. After withdrawing from public life, Dr. Kumar spent fourteen years in contemplative retreat in the forests of Ganderbal — a period marked by silence, muraqaba (meditation), and profound spiritual discipline."}],["$","p",null,{"children":"Through years of contemplative discipline and reflective silence in Kashmir's landscapes, he embodied a transformative practice rooted in the Sufi philosophy of Fana (annihilation of self) and the Qalandari path toward enlightenment."}],["$","p",null,{"children":"This transformation shaped his emergence as a spiritual guide — one rooted in truth rather than title, in presence rather than proclamation."}],["$","p",null,{"children":"His teaching methodology emphasized inner transformation through silence and conscious presence. As he observed: \"Silence is not the absence of sound, but the presence of the Divine.\" Healing, in his framework, emerges from within rather than through external intervention."}]]}]}]
12:["$","section",null,{"className":"bg-[var(--color-midnight)]\n        py-12 md:py-16\n        py-12","children":["$","div",null,{"className":"w-full\n        max-w-[1200px]\n        mx-auto\n        px-4\n        md:px-6","children":["$","div",null,{"className":"max-w-4xl","children":[["$","h2",null,{"className":"text-3xl font-bold text-white mb-6","children":"Core Teaching Domains"}],["$","p",null,{"className":"text-amber-400/70 text-sm mb-6","children":"Structured Philosophical Framework"}],["$","div",null,{"className":"bg-neutral-900/30 border border-neutral-800 rounded-lg p-8","children":["$","div",null,{"className":"space-y-4 text-neutral-300 text-sm leading-relaxed","children":[["$","p",null,{"children":"Dr. Kumar's work synthesizes classical Kashmiri Sufi insight with a structured framework of inner transformation and holistic engagement with the world. His integrated approach encompasses six interconnected domains:"}],["$","div",null,{"className":"mt-6 space-y-3","children":[["$","div",null,{"className":"border-l-2 border-amber-500/30 pl-4","children":[["$","p",null,{"className":"font-medium text-white mb-1","children":"Divine Healing & Holistic Wellbeing"}],["$","p",null,{"className":"text-neutral-400 text-xs","children":"Wholeness in healing that addresses body, mind, and spirit as integrated realities."}]]}],["$","div",null,{"className":"border-l-2 border-amber-500/30 pl-4","children":[["$","p",null,{"className":"font-medium text-white mb-1","children":"Environmental Stewardship as Sacred Responsibility"}],["$","p",null,{"className":"text-neutral-400 text-xs","children":"Reverence for the natural world as spiritually significant, including water conservation and ecological consciousness."}]]}],["$","div",null,{"className":"border-l-2 border-amber-500/30 pl-4","children":[["$","p",null,{"className":"font-medium text-white mb-1","children":"Bridging Spiritual Wisdom with Rigorous Inquiry"}],["$","p",null,{"className":"text-neutral-400 text-xs","children":"Synthesis of contemplative insight with rational exploration and scientific methodology."}]]}],["$","div",null,{"className":"border-l-2 border-amber-500/30 pl-4","children":[["$","p",null,{"className":"font-medium text-white mb-1","children":"Education as Awakening & Consciousness Expansion"}],["$","p",null,{"className":"text-neutral-400 text-xs","children":"Education as a pathway to expanded consciousness, not merely information transfer."}]]}],["$","div",null,{"className":"border-l-2 border-amber-500/30 pl-4","children":[["$","p",null,{"className":"font-medium text-white mb-1","children":"Inner Peace Through Mindfulness"}],["$","p",null,{"className":"text-neutral-400 text-xs","children":"Cultivating presence and awareness as foundations for sustainable inner peace."}]]}],["$","div",null,{"className":"border-l-2 border-amber-500/30 pl-4","children":[["$","p",null,{"className":"font-medium text-white mb-1","children":"Transcendent Truth Beyond Religious Divisions"}],["$","p",null,{"className":"text-neutral-400 text-xs","children":"Universal spiritual principles that transcend sectarian boundaries and cultural limitations."}]]}]]}],["$","p",null,{"className":"mt-6","children":"This positions his teachings not as charismatic pronouncements but as sustained philosophical contributions with structured depth and institutional continuity."}]]}]}]]}]}]}]
