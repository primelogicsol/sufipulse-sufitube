<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <!-- Dark navy background with rounded corners -->
  <rect width="512" height="512" rx="96" fill="#0F172A"/>

  <!-- Crescent moon (top-right accent) -->
  <defs>
    <mask id="crescent-mask">
      <circle cx="402" cy="98" r="54" fill="white"/>
      <circle cx="424" cy="86" r="44" fill="black"/>
    </mask>
  </defs>
  <circle cx="402" cy="98" r="54" fill="#C8A75E" mask="url(#crescent-mask)" opacity="0.9"/>

  <!-- Star dot beside crescent -->
  <circle cx="457" cy="72" r="8" fill="#C8A75E" opacity="0.75"/>

  <!-- SP monogram in gold serif -->
  <text
    x="256"
    y="338"
    text-anchor="middle"
    font-family="Georgia, 'Times New Roman', serif"
    font-size="252"
    font-weight="bold"
    fill="#C8A75E"
    letter-spacing="-6"
  >SP</text>

  <!-- Gold accent rule beneath text -->
  <rect x="108" y="382" width="296" height="2.5" rx="1.25" fill="#C8A75E" opacity="0.38"/>
</svg>
