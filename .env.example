# ============================================================================
#  SufiPulse — Environment Variables Reference (.env.example)
# ============================================================================
#
#  HOW TO USE:
#    1. Copy this file:  cp .env.example .env
#    2. Fill in real values for every variable (remove _CHANGE_ME suffixes)
#    3. Never commit .env to version control — it is already in .gitignore
#
#  CONVENTIONS:
#    - Variables starting with NEXT_PUBLIC_* are exposed to the browser bundle.
#    - All other variables are server-only (API routes, server components).
#    - Defaults are shown inline where applicable.
#    - Lines starting with # are optional in the specified environment.
#
#  GENERATING SECRETS:
#    JWT_SECRET / JWT_REFRESH_SECRET:
#      openssl rand -base64 48
#    Or on Windows (PowerShell):
#      [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
#
# ============================================================================

# ─────────────────────────────────────────────────────────────────────────────
#  DATABASE
# ─────────────────────────────────────────────────────────────────────────────
#
#  DATABASE_URL (REQUIRED)
#    Primary pooled connection to PostgreSQL (used by the ORM at runtime).
#    For Vercel + Neon / Supabase: use the "Pooled" connection string.
#    For local dev with Docker:  postgresql://postgres:postgres@localhost:5432/sufipulse
#
#  DIRECT_URL (OPTIONAL)
#    Direct (non-pooled) TCP connection for migrations, Prisma Studio, CLI.
#    Not needed for normal runtime — set it when you run `prisma migrate`.

DATABASE_URL="postgresql://user:password@localhost:5432/sufipulse"
DIRECT_URL="postgresql://user:password@localhost:5432/sufipulse?direct"

# ─────────────────────────────────────────────────────────────────────────────
#  AUTHENTICATION — JWT
# ─────────────────────────────────────────────────────────────────────────────
#
#  JWT_SECRET (REQUIRED)
#    Signs access tokens (short-lived). Minimum 32 characters.
#
#  JWT_REFRESH_SECRET (REQUIRED)
#    Signs refresh tokens (long-lived). Should differ from JWT_SECRET.
#    Minimum 32 characters.

JWT_SECRET="change-me-to-a-random-string-at-least-32-characters"
JWT_REFRESH_SECRET="change-me-to-a-different-random-32-char-str"

# ─────────────────────────────────────────────────────────────────────────────
#  EMAIL (SMTP) — Notification System
# ─────────────────────────────────────────────────────────────────────────────
#
#  Used to send status / onboarding emails to contributors.
#  SMTP_USER and SMTP_PASS are optional; without them no emails are sent.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password           # Gmail: use an App Password, not login password
FROM_EMAIL=noreply@sufipulse.com

# ─────────────────────────────────────────────────────────────────────────────
#  STRIPE — Payments & Subscriptions
# ─────────────────────────────────────────────────────────────────────────────
#
#  STRIPE_SECRET_KEY (REQUIRED)
#    Server-side key for creating checkout sessions, managing customers, etc.
#    Development:  sk_test_...
#    Production:   sk_live_...
#    Get from: https://dashboard.stripe.com/apikeys
#
#  STRIPE_WEBHOOK_SECRET (REQUIRED)
#    Signing secret for verifying Stripe webhook events.
#    Format: whsec_...
#    Get from: Stripe Dashboard > Developers > Webhooks > your endpoint

STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY (REQUIRED — baked into the client bundle)
#   The publishable key for Stripe.js on the frontend.
#   Development:  pk_test_...
#   Production:   pk_live_...
#   Get from: https://dashboard.stripe.com/apikeys

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME

# ─────────────────────────────────────────────────────────────────────────────
#  YOUTUBE DATA API — SufiTube Integration
# ─────────────────────────────────────────────────────────────────────────────
#
#  YOUTUBE_API_KEY (REQUIRED)
#    Used to fetch video metadata, channel stats, and embed info.
#    Get from: https://console.cloud.google.com/apis/credentials
#    Enable: YouTube Data API v3

YOUTUBE_API_KEY=AIzaSy_CHANGE_ME

# NEXT_PUBLIC_YOUTUBE_API_KEY (REQUIRED — baked into the client bundle)
#   Same key as YOUTUBE_API_KEY. Used in browser-side calls to YouTube Data API.
#   Get from: https://console.cloud.google.com/apis/credentials

NEXT_PUBLIC_YOUTUBE_API_KEY=AIzaSy_CHANGE_ME

# YOUTUBE_CHANNEL_ID (REQUIRED)
#   The channel ID for your SufiPulse YouTube channel.
#   Find it in YouTube Studio > Settings > Channel > Advanced settings.

YOUTUBE_CHANNEL_ID=UCraDr3i5A3k0j7typ6tOOsQ

# ─────────────────────────────────────────────────────────────────────────────
#  YOUTUBE ANALYTICS API — Global Reach Strip on /releases
# ─────────────────────────────────────────────────────────────────────────────
#
#  Enables the "SufiPulse Global Reach" audience intelligence section.
#  Requires OAuth 2.0 credentials for the channel owner account.
#
#  How to get these:
#  1. Go to https://console.cloud.google.com/apis/credentials
#  2. Create an OAuth 2.0 Client ID (type: Web application)
#  3. Enable: YouTube Analytics API
#  4. Use OAuth Playground (https://developers.google.com/oauthplayground)
#     - Scope: https://www.googleapis.com/auth/yt-analytics.readonly
#     - Exchange authorization code for tokens, copy the refresh_token
#
#  If not configured, the reach strip is silently hidden on /releases.

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
#  GOOGLE ADS API (Optional — managed campaigns / sponsor features)
# ─────────────────────────────────────────────────────────────────────────────
#
#  These are only required if you use SufiPulse's Google Ads integration
#  for sponsor-managed campaigns or the "Use My Google Ads" sponsor flow.
#
#  GOOGLE_ADS_DEVELOPER_TOKEN
#    Get from: https://ads.google.com/home/tools/developer-token/
#
#  GOOGLE_ADS_CLIENT_ID  &  GOOGLE_ADS_CLIENT_SECRET
#    OAuth2 credentials for sponsor authentication.
#    Get from: https://console.cloud.google.com/apis/credentials

# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
#  SENTRY — Error Tracking (Optional but strongly recommended for production)
# ─────────────────────────────────────────────────────────────────────────────
#
#  SENTRY_DSN
#    Data Source Name from your Sentry project. Enables error reporting.
#    Get from: Sentry Dashboard > Settings > Projects > your-project > Client Keys
#
#  SENTRY_ORG
#    Your Sentry organisation slug. Used for source map uploads during build.
#    Get from: Sentry Dashboard > Settings > Organisation > slug
#
#  SENTRY_PROJECT
#    Your Sentry project slug.
#    Get from: Sentry Dashboard > Settings > Projects > your-project

# SENTRY_DSN=https://CHANGE_ME@oXXXXXX.ingest.sentry.io/XXXXXXX
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=sufipulse

# ─────────────────────────────────────────────────────────────────────────────
#  DATABASE (File-based — advanced overrides)
# ─────────────────────────────────────────────────────────────────────────────
#
#  DB_DATA_DIR (Optional)
#    Directory for JSON data files. Defaults to .data in the project root.
#    In Docker, this is the path inside the container (mounted as a volume).

DB_DATA_DIR=.data

# ─────────────────────────────────────────────────────────────────────────────
#  LEGACY — Not used in the current codebase (safe to omit)
# ─────────────────────────────────────────────────────────────────────────────
#
#  The following variables are kept for reference only.
#  The project no longer uses Supabase or a separate Express API server.

# NEXT_PUBLIC_SUPABASE_URL=https://CHANGE_ME.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...CHANGE_ME
# API_URL=http://localhost:5000/api

# ─────────────────────────────────────────────────────────────────────────────
#  APPLICATION
# ─────────────────────────────────────────────────────────────────────────────
#
#  NEXT_PUBLIC_APP_URL (REQUIRED)
#    Canonical base URL of the application. Used for absolute links, OG tags,
#    email links, and OAuth redirect callbacks.
#    Development: http://localhost:3000
#    Production:  https://sufipulse.com

NEXT_PUBLIC_APP_URL=http://localhost:3000

#  NODE_ENV
#    Automatically set by Next.js. Do not override manually.
#    Values: development | production | test
#
#  CORS_ORIGINS (Optional)
#    Comma-separated list of allowed CORS origins.
#    Default: http://localhost:3000

CORS_ORIGINS=http://localhost:3000

#  DEBUG_ENV (Optional)
#    Set to "true" to print validated env vars on startup (for debugging).

DEBUG_ENV=false
