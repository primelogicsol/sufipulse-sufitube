# Production Environment Variables
# Copy this file to .env.production and fill in actual values

# API
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api

# YouTube
NEXT_PUBLIC_YOUTUBE_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sentry (Error Tracking)
# Get your DSN from: https://sentry.io/settings/<your-org>/projects/<your-project>/keys/
NEXT_PUBLIC_SENTRY_DSN=

# Sentry CLI Auth Token (for source map upload during build)
# Get your auth token from: https://sentry.io/settings/account/api/auth-tokens/
# Required scopes: project:releases, project:write, org:read
SENTRY_AUTH_TOKEN=

# Sentry organization and project slugs (for CLI)
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
