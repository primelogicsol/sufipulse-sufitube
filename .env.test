# ============================================================================
#  SufiPulse — Test Environment
# ============================================================================
#  Used by automated test runners (Jest, Playwright, Vitest, etc.).
#  Values here should be safe, disposable, and never point to production.
# ============================================================================

# ── Database (test database — truncated between runs) ───────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sufipulse_test"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/sufipulse_test?direct"

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET="test-jwt-secret-for-ci-must-be-32+chars-long!!!"
JWT_REFRESH_SECRET="test-refresh-secret-for-ci-must-be-32+chars!!!"

# ── Email (disabled in tests) ────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
FROM_EMAIL=test@sufipulse.local

# ── Stripe (test keys — no real charges) ─────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_fake_key_for_ci_environment
STRIPE_WEBHOOK_SECRET=whsec_fake_webhook_secret_for_ci

# ── YouTube ──────────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=AIzaSyFakeKeyForTesting1234567890

# ── Google Ads (disabled in tests) ───────────────────────────────────────────
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=

