NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://test.sufipulse.com
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_RANDOM_64_CHAR_STRING

# ── Email (password reset & verification) ───────────────────────────────────
# IONOS SMTP — use your full IONOS email address and its password.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.ionos.com
SMTP_PORT=587
SMTP_USER=noreply@sufipulse.com
SMTP_PASS=your-ionos-email-password
EMAIL_FROM=SufiPulse <noreply@sufipulse.com>
