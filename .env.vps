NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://test.sufipulse.com
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_RANDOM_64_CHAR_STRING

# ── Email (password reset & verification) ───────────────────────────────────
# Set EMAIL_PROVIDER=smtp and fill SMTP_USER / SMTP_PASS to send real emails.
# For Gmail: enable 2-Step Verification, then create an App Password at
#   https://myaccount.google.com/apppasswords
# Use that 16-char App Password as SMTP_PASS (not your real Gmail password).
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=SufiPulse <noreply@sufipulse.com>
